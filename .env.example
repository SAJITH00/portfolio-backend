# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/sajith_portfolio
# Example Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sajith_portfolio?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Initial Admin Seed Credentials
ADMIN_USERNAME=sajith_admin
ADMIN_EMAIL=admin@sajith.dev
ADMIN_PASSWORD=ChangeMeStrongPassword123!

# Email Service (Resend or SMTP)
EMAIL_SERVICE=resend
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_EMAIL_TO=sajith.dev@example.com
EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>

# Optional SMTP fallback (if EMAIL_SERVICE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Privacy Salt for Visitor Tracking
VISITOR_SALT=change_this_to_a_random_salt_in_production
